[ext_resource type="Script" path="res://src/core/CarryRules.gd" id="1_rules"]

[resource]
script = ExtResource("1_rules")
; GDD 5.1: capacidade do jogador de 50 kg, sem lentidão; impede pegar acima de 100%.
capacity_kg = 50.0
; Peso de uma unidade, em kg. Os da tabela de 5.1 e 5.9 vêm do GDD; os marcados [premissa] são nossos.
; Peça e mobília pesam o MESMO que o material que as faz (carregar a parede = carregar a madeira dela): o abrigo
; mínimo (4 fundações, 8 paredes, 1 porta) fecha nos 38,05 kg do GDD. [premissa] A Ração (0,2) pesa mais que o
; material (3 bagas = 0,3 para 2 rações = 0,4): é a fabricação que sai mais pesada.
