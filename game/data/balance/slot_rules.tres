script = ExtResource("1_rules")
; GDD 5.21 (decisão do dono, 07/11): 4 slots de grade. [premissa] Cinto de 4 posições para as ferramentas (shiro.md 4.7);
; a vaga Arma é à parte (EquipmentLayout), então o jogador leva até 5 ferramentas fora dos slots.
player_slots = 4
belt_slots = 4
; GDD 5.21 (decisão do dono): Cesto de fibra +4 (8 no total) e Mochila de couro +8 (12). Uma vaga só; vale a equipada.
bag_slots = Dictionary[String, int]({
"fiber_basket": 4,
"leather_backpack": 8
})
