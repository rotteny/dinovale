; Engine configuration file.
; Prefira editar pelo editor do Godot (Project > Project Settings).

config_version=5

[application]

config/name="Dino Vale"
config/description="Sandbox survival 2D top-down em pixel art, comunitário e auto-hospedado."
run/main_scene="res://src/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

